# ============================================================
# STORAGE — Upstash Redis (gratis) via Vercel Marketplace
# ============================================================
# Cara setup (free account Vercel):
#   1. Buka dashboard project di vercel.com → tab "Storage"
#   2. Pilih "Create Database" → "Upstash" → "Redis" (plan Free)
#   3. Connect ke project ini — env di bawah terisi otomatis di Vercel
#   4. Untuk development lokal: jalankan `vercel env pull .env.local`,
#      atau salin nilainya manual ke .env.local
#
# Tanpa env ini, saat development data disimpan ke file .data/*.json
# (otomatis, tidak perlu setup). Di Vercel production, env ini WAJIB
# agar RSVP / ucapan / daftar undangan tersimpan.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternatif (nama env bila membuat database langsung dari upstash.com):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# UPLOAD FOTO — Vercel Blob (gratis) via tab Storage
# ============================================================
# Cara setup (free account Vercel):
#   1. Buka dashboard project di vercel.com → tab "Storage"
#   2. Pilih "Create Database" → "Blob" (plan Free/Hobby)
#   3. Connect ke project ini — env di bawah terisi otomatis di Vercel
#   4. Untuk development lokal: jalankan `vercel env pull .env.local`,
#      atau salin nilainya manual ke .env.local
#
# Tanpa env ini, saat development foto disimpan ke public/uploads/
# (otomatis, tidak perlu setup). Di Vercel production, env ini WAJIB
# agar halaman /undangan_setting bisa mengunggah foto.

BLOB_READ_WRITE_TOKEN=
